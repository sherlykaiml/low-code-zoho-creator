 application "College Hostel Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form allocation_complaint
		{
			displayname = "Allocation Complaint"
			success message = "Allocation Complaint Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			request_type
			(
				type = radiobuttons
				displayname = "Request Type"
				values = {"Hostel Complaint","Room Allocation"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			student_register_number
			(
    			type = text
				displayname = "Student Register Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			student_name
			(
    			type = name
				displayname = "Student Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_number
			(
    			type = text
				displayname = "Room Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			allocation_date
			(
    			type = date
				displayname = "Allocation Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			allocation_status
			(
				type = picklist
				displayname = "Allocation Status"
				values = {"Rejected","Allocated","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			complaint_category
			(
				type = picklist
				displayname = "Complaint Category"
				values = {"Plumbing","Cleaning","Electrical","Internet","Food","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			complaint_description
			(
    			type = textarea
				displayname = "Complaint Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			complaint_date
			(
    			type = date
				displayname = "Complaint Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			complaint_status
			(
				type = picklist
				displayname = "Complaint Status"
				values = {"In Progress","Resolved","Open"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			linked_student
			(
				type = picklist	
				displayname = "Linked Student"
				values  = student_registration.ID
    			displayformat = [register_number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			linked_room
			(
				type = picklist	
				displayname = "Linked Room"
				values  = room_management.ID
    			displayformat = [room_number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Complaint Created","Under Review","Draft","Assigned to Maintenance","Assigned to Administration","Rejected","Pending Information","In Progress","Resolved","On Hold","Escalated","Pending Verification","Closed"}
			}
		}
		form room_management
		{
			displayname = "Room Management"
			success message = "Room Management Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			room_number
			(
    			type = text
				displayname = "Room Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			hostel_block
			(
				type = picklist
				displayname = "Hostel Block"
				values = {"Block C","Block B","Block A"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_type
			(
				type = picklist
				displayname = "Room Type"
				values = {"Two Sharing","Three Sharing","Four Sharing"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_capacity
			(
				type = number
				displayname = "Total Capacity"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			current_occupancy
			(
				type = number
				displayname = "Current Occupancy"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_status
			(
				type = picklist
				displayname = "Room Status"
				values = {"Available","Maintenance","Full"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_updated
			(
    			type = datetime
				displayname = "Last Updated"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form student_registration
		{
			displayname = "Student Registration"
			success message = "Student Registration Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			student_name
			(
    			type = name
				displayname = "Student Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			register_number
			(
    			type = text
				displayname = "Register Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			college_email
			(
    			type = email
				displayname = "College Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"Civil","CSE","EEE","ECE","Mechanical","IT","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			year_of_study
			(
				type = picklist
				displayname = "Year Of Study"
				values = {"First Year","Fourth Year","Second Year","Third Year"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			hostel_preference
			(
				type = radiobuttons
				displayname = "Hostel Preference"
				values = {"Girls Hostel","Boys Hostel"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			room_type_preference
			(
				type = picklist
				displayname = "Room Type Preference"
				values = {"Two Sharing","Three Sharing","Four Sharing"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			reason_for_accommodation
			(
    			type = textarea
				displayname = "Reason for Accommodation"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_status
			(
				type = picklist
				displayname = "Application Status"
				values = {"Approved","Rejected","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_date
			(
    			type = datetime
				displayname = "Application Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			allocated_room
			(
				type = picklist	
				displayname = "Allocated Room"
				values  = room_management.ID
    			displayformat = [room_number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Registration Initiated","Application Under Review","Eligibility Verified","Application Rejected","Room Allocation Pending","Room Allocated","Waitlist","Allocation Confirmed","Process Completed"}
			}
		}
	}
	reports
	{
		list allocation_complaint_Report
		{
			displayName = "All Allocation Complaints"
			show all rows from allocation_complaint    
			(
				request_type as "Request Type"
				student_register_number as "Student Register Number"
				student_name  as "Student Name"
				room_number as "Room Number"
				allocation_date as "Allocation Date"
				allocation_status as "Allocation Status"
				complaint_category as "Complaint Category"
				complaint_description as "Complaint Description"
				complaint_date as "Complaint Date"
				complaint_status as "Complaint Status"
				linked_student as "Linked Student"
				linked_room as "Linked Room"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (complaint_status == "In Progress")
				fields = [complaint_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (complaint_status == "Open")
				fields = [complaint_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (complaint_status == "Resolved")
				fields = [complaint_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban allocation_complaint_by_complaint_category
		{
			displayName = "Complaint Categories"
			show all rows from allocation_complaint    
			(
				request_type as "Request Type"
				student_register_number as "Student Register Number"
				student_name  as "Student Name"
				room_number as "Room Number"
				allocation_date as "Allocation Date"
				allocation_status as "Allocation Status"
				complaint_category as "Complaint Category"
				complaint_description as "Complaint Description"
				complaint_date as "Complaint Date"
				complaint_status as "Complaint Status"
				linked_student as "Linked Student"
				linked_room as "Linked Room"
			)
			options
			(
	 			display field = complaint_category
	 		)
		}
		list room_management_Report
		{
			displayName = "All Room Management"
			show all rows from room_management    
			(
				room_number as "Room Number"
				hostel_block as "Hostel Block"
				room_type as "Room Type"
				total_capacity as "Total Capacity"
				current_occupancy as "Current Occupancy"
				room_status as "Room Status"
				last_updated as "Last Updated"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (hostel_block == "Block A")
				fields = [hostel_block]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (hostel_block == "Block B")
				fields = [hostel_block]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (hostel_block == "Block C")
				fields = [hostel_block]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban room_management_by_hostel_block
		{
			displayName = "Hostel Blocks"
			show all rows from room_management    
			(
				room_number as "Room Number"
				hostel_block as "Hostel Block"
				room_type as "Room Type"
				total_capacity as "Total Capacity"
				current_occupancy as "Current Occupancy"
				room_status as "Room Status"
				last_updated as "Last Updated"
			)
			options
			(
	 			display field = hostel_block
	 		)
		}
		list student_registration_Report
		{
			displayName = "All Student Registrations"
			show all rows from student_registration    
			(
				student_name  as "Student Name"
				register_number as "Register Number"
				college_email as "College Email"
				department as "Department"
				year_of_study as "Year Of Study"
				phone_number as "Phone Number"
				hostel_preference as "Hostel Preference"
				room_type_preference as "Room Type Preference"
				reason_for_accommodation as "Reason for Accommodation"
				application_status as "Application Status"
				application_date as "Application Date"
				allocated_room as "Allocated Room"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (year_of_study == "First Year")
				fields = [year_of_study]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (year_of_study == "Fourth Year")
				fields = [year_of_study]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (year_of_study == "Third Year")
				fields = [year_of_study]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban student_registration_by_department
		{
			displayName = "Departments"
			show all rows from student_registration    
			(
				student_name  as "Student Name"
				register_number as "Register Number"
				college_email as "College Email"
				department as "Department"
				year_of_study as "Year Of Study"
				phone_number as "Phone Number"
				hostel_preference as "Hostel Preference"
				room_type_preference as "Room Type Preference"
				reason_for_accommodation as "Reason for Accommodation"
				application_status as "Application Status"
				application_date as "Application Date"
				allocated_room as "Allocated Room"
			)
			options
			(
	 			display field = department
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
