		workflow
		{
		form
		{
			auto_set_application_status as "Auto-Set Application Status"
			{
				type =  form
				form = student_registration

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Set the application_status field to Pending when a new student registration is submitted
										input.application_status = "Pending";
										// Log the current user ID for reference
										info zoho.loginuserid;
						)
					}
				}

			}
			notify_student_on_approval as "Notify Student on Approval"
			{
				type =  form
				form = student_registration

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.application_status == "Approved")
										{
											studentEmail = input.college_email;
											if(studentEmail != null && studentEmail != "")
											{
												studentName = ifnull(input.student_name,"Student");
												studentDepartment = ifnull(input.department,"Not specified");
												studentYear = ifnull(input.year_of_study,"Not specified");
												emailSubject = "Hostel Application Approved";
												emailMessage = "<html><body>" + "<h2>Hostel Application Approved</h2>" + "<p>Dear " + studentName + ",</p>" + "<p>We are pleased to inform you that your hostel accommodation application has been <b>approved</b>.</p>" + "<h3>Application Details</h3>" + "<p><b>Student Name:</b> " + studentName + "</p>" + "<p><b>Department:</b> " + studentDepartment + "</p>" + "<p><b>Year of Study:</b> " + studentYear + "</p>" + "<p>Please contact the hostel administration for room allocation and check-in instructions.</p>" + "<p>Best regards,<br>Hostel Management Team<br>College Administration</p>" + "</body></html>";
												sendmail
												[
													from :zoho.loginuserid
													to :studentEmail
													subject :emailSubject
													message :emailMessage
													content type :HTML
												]
											}
										}
						)
					}
				}

			}
			send_welcome_email_on_registration as "Send Welcome Email on Registration"
			{
				type =  form
				form = student_registration

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch student details from input
										studentName = input.student_name;
										registerNumber = input.register_number;
										emailAddress = input.college_email;
										input.department = input.department;
										yearOfStudy = input.year_of_study;
										hostelPreference = input.hostel_preference;
										applicationDate = input.application_date;
										// Format the application date for display
										formattedDate = applicationDate.toString("MMM dd, yyyy");
										// Construct the welcome message
										message = "<p>Dear " + studentName.first_name + ",</p>";
										message = message + "<p>Congratulations! Your hostel accommodation application has been successfully submitted.</p>";
										message = message + "<p><strong>Registration Details:</strong></p>";
										message = message + "<ul>";
										message = message + "<li>Register Number: " + registerNumber + "</li>";
										message = message + "<li>Department: " + input.department + "</li>";
										message = message + "<li>Year of Study: " + yearOfStudy + "</li>";
										message = message + "<li>Hostel Preference: " + hostelPreference + "</li>";
										message = message + "<li>Application Date: " + formattedDate + "</li>";
										message = message + "</ul>";
										message = message + "<p>Your application status is currently set to 'Pending'. You will be notified once the allocation process is complete.</p>";
										message = message + "<p>Thank you for choosing our hostel facilities.</p>";
										message = message + "<p>Best Regards,<br>Hostel Management Team</p>";
										// Send the welcome email
										sendmail
										[
											from :zoho.adminuserid
											to :emailAddress
											subject :"Hostel Application Confirmation - " + registerNumber
											message :message
											content type :HTML
										]
						)
					}
				}

			}
		}

		schedule
		{
			daily_room_status_sync as "Daily Room Status Sync"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all room management records
										roomRecords = room_management[ID != 0];
										// Iterate through each room record
										for each  room in roomRecords
										{
											// Check if current occupancy equals total capacity
											if(room.current_occupancy == room.total_capacity)
											{
												// Update room status to Full
												room.room_status="Full";
											}
											else if(room.current_occupancy < room.total_capacity)
											{
												// Update room status to Available if occupancy is less than capacity
												room.room_status="Available";
											}
										}
										// Log the update operation
										info "Room status updated successfully based on occupancy and capacity";
					)
					}
				}
			}
		}


